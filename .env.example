# ============================================================
#  SN Data Migration — Environment Configuration
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your values below
#  3. Never commit .env to version control
# ============================================================

# ── ServiceNow ───────────────────────────────────────────────
SN_INSTANCE_URL=https://yourinstance.service-now.com

# Auth option A — Basic (username + password) — works for everyone
SN_USERNAME=your_sn_username
SN_PASSWORD=your_sn_password

# Auth option B — OAuth via @servicenow/sdk (leave USERNAME/PASSWORD blank)
# Requires: npx @servicenow/sdk auth --add https://yourinstance.service-now.com
# Then set: SN_USE_SDK_AUTH=true
SN_USE_SDK_AUTH=false

# Staging table prefix:
#   global scope  → SN_SCOPE_PREFIX=u   (tables named u_stg_sf_account)
#   scoped app    → SN_SCOPE_PREFIX=x_myapp
SN_SCOPE_PREFIX=u

# ── Salesforce ───────────────────────────────────────────────
# Create a Connected App in Salesforce Setup → App Manager
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_USERNAME=your_sf_username@example.com
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_sf_security_token
SF_API_VERSION=v59.0

# ── Jira ─────────────────────────────────────────────────────
# Generate API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PAGE_SIZE=50

# ── Migration settings ────────────────────────────────────────
MIGRATION_PAGE_SIZE=200
MIGRATION_TEST_LIMIT=10
LOG_LEVEL=info

# ── HTTP/SSE server ────────────────────────────────────────────
MCP_MODE=http
MCP_PORT=3000

# MCP_API_KEY  : legacy single shared key (all users share this)
# ALLOWED_KEYS : per-user tokens — comma-separated, generated via POST /register
# ADMIN_KEY    : protects POST /register and DELETE /register/:token
#
# Recommended setup:
#   1. Set ADMIN_KEY to a strong secret (only you know this)
#   2. Leave MCP_API_KEY / ALLOWED_KEYS empty
#   3. Use POST /register (with your ADMIN_KEY) to issue tokens to each user
#   4. Revoke with DELETE /register/:token at any time
MCP_API_KEY=
ALLOWED_KEYS=
ADMIN_KEY=change_me_to_a_strong_admin_secret
